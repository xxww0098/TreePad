{
  "name": "treepad",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "build": "vue-tsc -b && vite build -c vite.config.content.ts && vite build -c vite.config.markdown-runtime.ts && vite build -c vite.config.zip-runtime.ts && vite build -c vite.config.background.ts",
    "build:content": "vite build -c vite.config.content.ts",
    "build:runtimes": "vite build -c vite.config.markdown-runtime.ts && vite build -c vite.config.zip-runtime.ts",
    "build:background": "vite build -c vite.config.background.ts",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.23",
    "@vueuse/core": "^14.2.1",
    "dompurify": "^3.3.3",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "marked": "^17.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.38",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "happy-dom": "^20.8.4",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6"
  }
}
