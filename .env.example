# Default GitHub OAuth configuration for release builds.
# Copy to `.env.local` or `.env.production.local` and fill with your release values.

# Required to enable OAuth by default in published builds.
VITE_GITHUB_OAUTH_CLIENT_ID=

# Optional metadata shown in Settings and release docs.
VITE_GITHUB_OAUTH_APP_NAME=TreePad
VITE_GITHUB_OAUTH_APP_HOMEPAGE=https://github.com/your-org/TreePad

# Optional: the published Chrome extension ID.
# Used by release helper docs to render the final callback URL.
TREEPAD_EXTENSION_ID=
